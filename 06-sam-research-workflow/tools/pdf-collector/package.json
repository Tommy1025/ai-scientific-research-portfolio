    "browser:install": "node scripts/install-browser.js",
    "revalidate:main": "node --use-system-ca scripts/revalidate-main.js",
    "smoke:si": "node --use-system-ca scripts/smoke-si.js 10.1038/s41586-025-09333-z 10.1021/acsnano.5c01479",
    "smoke:main": "node --use-system-ca scripts/smoke-main.js"
  },
  "dependencies": {
