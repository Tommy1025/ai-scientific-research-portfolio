{
  "name": "sam-reference-pdf-collector",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "本機執行的 SAM 論文參考文獻主文與 SI 蒐集器",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --use-system-ca server.js",
