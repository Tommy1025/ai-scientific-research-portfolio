    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "adm-zip": "^0.6.0",
    "archiver": "^7.0.1",
    "cheerio": "^1.1.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "playwright": "^1.56.0",
    "word-extractor": "^1.0.4"
  }
