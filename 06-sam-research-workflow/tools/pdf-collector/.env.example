# 複製成 .env 後填入；請勿提交真實憑證。
OPENALEX_API_KEY=
CORE_API_KEY=
# 匿名查詢容易遇到 429；大量工作建議申請 key，程式仍會遵守 rate limit。
SEMANTIC_SCHOLAR_API_KEY=
WILEY_TDM_CLIENT_TOKEN=
ELSEVIER_API_KEY=
# 只有 Elsevier Support 或圖書館提供時才填。
ELSEVIER_INST_TOKEN=
# 請填一篇機構確實訂閱、且不是 OA 的 Elsevier DOI；留空時不宣稱 FULL／entitlement 已可用。
ELSEVIER_ENTITLEMENT_TEST_DOI=
# 只填有效的 Springer Nature API key；健康檢查 401 代表 key 無效或未授權。
SPRINGER_NATURE_API_KEY=
# 若 NTNU 已採購 LibKey，向圖書館索取 Library ID 與 Integrator API key。
LIBKEY_LIBRARY_ID=
LIBKEY_API_KEY=
# GetFTR 需完成 integrator 註冊；smart link 不等於可背景保存 PDF。
GETFTR_API_KEY=
# 選配最後備援；只對指定失敗 ref 使用專案內 Playwright persistent profile。
BROWSER_FALLBACK_ENABLED=false
